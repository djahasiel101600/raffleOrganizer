# Raffle Ticket Reservation — Docker deployment settings.
# Copy to `.env` next to docker-compose.yml and adjust before `docker compose up`.

# ---------------------------------------------------------------------------
# Django API (raffle-ticket-api)
# ---------------------------------------------------------------------------

# REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Keep off (0) in production.
DJANGO_DEBUG=0

# Hosts the API may be reached under.  Add your public domain here when you
# have one; the containers also talk to each other over jdp-network.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin(s) users browse (needed only for the Django admin CSRF check;
# include scheme, comma separated).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Only needed for cross-origin API clients (e.g. the Vite dev server);
# the production setup is same-origin through the web proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://raffle.jdp-homelab.space

DJANGO_TIME_ZONE=Asia/Manila

# 1 = the /api/monitor/ display screen is public; 0 = login required.
DJANGO_PUBLIC_MONITOR=1

# ---------------------------------------------------------------------------
# First administrator (created automatically on API startup, idempotent)
# ---------------------------------------------------------------------------

RAFFLE_ADMIN_USERNAME=admin
RAFFLE_ADMIN_PASSWORD=change-me-immediately
RAFFLE_ADMIN_EMAIL=admin@example.com
# Set to 0 to skip automatic admin creation entirely.
RAFFLE_BOOTSTRAP_ADMIN=1

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------

# Host port for the web app (SPA + proxied API/WebSocket/media).
RAFFLE_WEB_PORT=8080
